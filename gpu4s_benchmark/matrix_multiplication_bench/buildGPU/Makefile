.PHONY : openmp/lib_omp_opt.i

# target to preprocess a source file
openmp/lib_omp_opt.cpp.i:
	$(MAKE) $(MAKESILENT) -f CMakeFiles/matrix_mult_openmp_opt.dir/build.make CMakeFiles/matrix_mult_openmp_opt.dir/openmp/lib_omp_opt.cpp.i
.PHONY : openmp/lib_omp_opt.cpp.i

openmp/lib_omp_opt.s: openmp/lib_omp_opt.cpp.s
.PHONY : openmp/lib_omp_opt.s

# target to generate assembly for a file
openmp/lib_omp_opt.cpp.s:
	$(MAKE) $(MAKESILENT) -f CMakeFiles/matrix_mult_openmp_opt.dir/build.make CMakeFiles/matrix_mult_openmp_opt.dir/openmp/lib_omp_opt.cpp.s
.PHONY : openmp/lib_omp_opt.cpp.s

